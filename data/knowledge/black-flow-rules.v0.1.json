  "resource_lifecycle_policy": {
    "schema_version": "0.1.0",
    "status": "planner_heuristic",
    "summary": "用随层数递减的未来选择权估值加工品，并在后期提高源石锭与箱位的兑现压力；这是可调启发式，不是游戏固定数值。",
    "principles": [
      "用户设置的至少保留次数是硬约束，自动阶段目标只是软约束",
      "可跨层且目标范围广的加工品在前期具有更高选择权价值",
      "不能携带到下一区域的加工品在离层前应优先使用",
      "后期源石锭高于保留线时提高行商路线价值，但行商仅视为消费机会，不预设具体购买结果",
      "零件箱接近或超过容量时提高行商出售与消耗加工品的价值",
      "后期仍不强制清空；只有替代路线收益超过保留价值时才使用零件"
    ],
    "part_intrinsic_value_model": {
      "status": "planner_heuristic",
      "unit": "route_score_per_use",
      "summary": "将加工品的可控移动范围、节省行动力、跨越未完成节点、附带效果和避免行动力耗尽的保险作用估为每次使用的内在效用；不等同于商店售价。",
      "base_controlled_move": 0.6,
